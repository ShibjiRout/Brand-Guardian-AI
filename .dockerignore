# Virtual Environment - never include this
.venv
venv
env

# Git
.git
.gitignore

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Environment variables - never include secrets
.env
.env.*

# Temp files generated during runtime
temp_audit_video.mp4
*.mp4
*.avi
*.mov

# IDE and editor files
.vscode
.idea
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Test files
tests/
*.test.py

# Logs
*.log
logs/

# Notebook files
*.ipynb
.ipynb_checkpoints

# Documentation
*.md
docs/

# The frontend (web/) is a separate static site, not served by this API —
# Caddy serves it directly from disk on the server. Excluded here so it
# doesn't bloat the API image for no reason.
web/

# Claude Code local tooling state (worktrees, etc.) — never needed in the image
.claude/