# Virtual Environment - never include this
.venv
venv
env

# Git
.git
.gitignore

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Environment variables - never include secrets
.env
.env.*

# Temp files generated during runtime
temp_audit_video.mp4
*.mp4
*.avi
*.mov

# IDE and editor files
.vscode
.idea
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Test files
tests/
*.test.py

# Logs
*.log
logs/

# Notebook files
*.ipynb
.ipynb_checkpoints

# Documentation
*.md
docs/

# The frontend (web/) is a separate static site, not served by this API,
# but is still copied into the image today since Dockerfile uses `COPY . .`.
# Not harmful, just unnecessary image bloat — exclude web/ here if that
# ever needs trimming down.